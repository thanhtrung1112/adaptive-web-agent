{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniBiz benchmark task",
  "type": "object",
  "required": ["id", "title", "module", "difficulty", "goal", "start_url", "seed", "success_criteria", "max_steps", "critical_elements"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "module": {"enum": ["crm", "order", "support", "chain"]},
    "difficulty": {"enum": ["single", "multi", "chain"]},
    "goal": {"type": "string", "minLength": 10},
    "start_url": {"type": "string", "pattern": "^/"},
    "seed": {"type": "string"},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 40},
    "critical_elements": {
      "type": "array", "minItems": 1,
      "items": {"type": "string"}
    },
    "success_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"enum": ["api_check", "download_check"]},
          "endpoint": {"type": "string", "pattern": "^/api/"},
          "expect": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
