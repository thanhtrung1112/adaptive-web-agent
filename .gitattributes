# Giữ byte của seed nhất quán giữa Windows, Linux và bản lưu trong Git.
data/seed_v1.json text eol=lf
data/manifest.json text eol=lf
# Task, mã nguồn và bằng chứng có byte ổn định khi checkout để đối chiếu hash.
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
requirements*.txt text eol=lf

# Raw captured HTML retains template whitespace to preserve DOM evidence/checksums.
# Disable only end-of-line whitespace warnings for this dataset's dom.html files.
results/w4/binh_v1/snapshots/**/dom.html whitespace=-blank-at-eol
# The evidence manifest hashes this text log too; keep its bytes stable on Windows.
results/w4/binh_v1/test_log.txt text eol=lf

# W5 evidence checksums remain stable on Windows.
Evidence/W05/** text eol=lf
Evidence/W05/figures/*.png binary
results/w5/published_v0.5.0/**/dom.html whitespace=-blank-at-eol

# W3 evidence manifest hashes these files too; keep checkout bytes stable on Windows.
results/w3/hybrid_planner_v1/README.md text eol=lf
results/w3/hybrid_planner_v1/software_tests.log text eol=lf
